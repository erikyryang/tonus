DB_HOST=localhost
DB_PORT=5432
DB_NAME=tonus
DB_USER=tonus
DB_PASSWORD=tonus

# Generate with: openssl rand -hex 32
JWT_SECRET=

# WhatsApp sending (SPEC-005). Off, notices only go to the log and no
# student gets a message — that's the development default. Only turn it on
# after the instance below is paired, or the first billing job sends a real
# message to a real student.
NOTIFICATION_ENABLED=false
# Where the APPLICATION reaches Evolution. In the documented dev flow the app
# runs on the host, so this is the published port (127.0.0.1:8081 in
# docker-compose.yml), not the compose service name — `evolution` only
# resolves for containers on the `tonus` network.
EVOLUTION_BASE_URL=http://localhost:8081
# Where the MANAGER's frontend, running in your browser, is told to reach the
# API back. Same address for the same reason.
EVOLUTION_SERVER_URL=http://localhost:8081
# Instance credential. The WhatsApp session it opens is worth as much as the
# studio's password — don't commit it, don't reuse it across environments.
# Generate with: openssl rand -hex 32
EVOLUTION_API_KEY=
# Seed only. Since SPEC-013 the authority is whatsapp_settings.instance_name,
# chosen by the ADMIN at /admin/whatsapp — this value just populates the row
# in migration V025. Editing it later changes nothing.
EVOLUTION_INSTANCE=tonus
# WhatsApp Web version Baileys announces. The container is what actually uses
# it; the application only reads it back to show as "in effect" on the admin
# screen. Leave as is until pairing starts failing (QR never connects, 405 /
# "connection failure"), then bump it to the value in
# WhiskeySockets/Baileys → src/Defaults/baileys-version.json — and recreate
# the evolution container, which is the only thing that applies it.
WHATSAPP_VERSION=2.3000.1043857760
