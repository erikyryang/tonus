DB_HOST=localhost
DB_PORT=5432
DB_NAME=tonus
DB_USER=tonus
DB_PASSWORD=tonus

JWT_SECRET=

# WhatsApp sending (SPEC-005). Off, notices only go to the log and no
# student gets a message — that's the development default.
NOTIFICATION_ENABLED=false
# Service name on the compose internal network. Evolution has no port
# published on the host: whoever talks to it is inside the same network.
EVOLUTION_BASE_URL=http://evolution:8080
# Instance credential. The WhatsApp session it opens is worth as much as the
# studio's password — don't commit it, don't reuse it across environments.
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=tonus
