DB_HOST=localhost
DB_PORT=5432
DB_NAME=tonus
DB_USER=tonus
DB_PASSWORD=tonus

JWT_SECRET=

# Envio de WhatsApp (SPEC-005). Desligado, os avisos só vão para o log e
# nenhum aluno recebe mensagem — é o default de desenvolvimento.
NOTIFICATION_ENABLED=false
# Nome do serviço na rede interna do compose. A Evolution não tem porta
# publicada no host: quem fala com ela está dentro da mesma rede.
EVOLUTION_BASE_URL=http://evolution:8080
# Credencial da instância. A sessão de WhatsApp que ela abre vale tanto quanto
# a senha do estúdio — não commitar, não reaproveitar entre ambientes.
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=tonus
