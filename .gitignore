### === Node / React / TypeScript (general) === ###

# Dependencies
node_modules/
jspm_packages/
bower_components/

# Builds / outputs
dist/
build/
out/
.next/
.nuxt/
.vercel/
.turbo/
storybook-static/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests / coverage
coverage/
.nyc_output/

# Environment variables
# Any .env stays out of git; only the example is versioned. The old list
# only covered the .local suffixes and let .env.development and
# .env.production slip through, which Vite reads just the same.
.env
.env.*
!.env.example

# Frontend-specific editor/OS files
.vite/
.rollup.cache/
# A TypeScript config makes Vite generate a temporary bundle next to the
# file; it's left over when the process dies midway.
vite.config.ts.timestamp-*
vite.config.js.timestamp-*
# Vite's convention for a machine-local-only override file.
*.local

### === Operating system / general editors === ###
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

### === OpenSpec === ###
# openspec/ must NOT be ignored (it's the project's source of truth).
# Just make sure the folders aren't empty (.gitkeep) before the first commit.

### === Claude Code (.claude) === ###
# Commit .claude/commands/ and .claude/skills/ (shared with the team).
# Only ignore local configs specific to your machine:
.claude/settings.local.json
.claude/*.local.json
